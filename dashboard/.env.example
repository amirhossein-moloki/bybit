# Base URL of the TradingBot backend.
# When set, API requests go directly to this URL (backend must allow CORS).
# When empty, the dashboard calls the same-origin "/api/*" path and relies on
# the Next.js rewrites (see next.config.mjs / API_PROXY_TARGET) to reach the backend.
# آدرس مستقیم API بک‌اند؛ در صورت خالی بودن، درخواست‌ها از مسیر هم‌منشأ /api/* پروکسی می‌شوند.
NEXT_PUBLIC_API_URL=

# Backend target used by the Next.js dev/prod server rewrites (same-origin mode).
# In Docker Compose environment, this points to the worker container (e.g. http://tradingbot-worker).
# In standalone local development, this points to http://localhost:5293.
# آدرس هدف بک‌اند جهت هدایت درخواست‌های پروکسی داشبورد Next.js
API_PROXY_TARGET=http://localhost:5293
