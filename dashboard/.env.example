# Base URL of the TradingBot backend.
# Development: NEXT_PUBLIC_API_URL=http://localhost:5000
# Docker Compose: NEXT_PUBLIC_API_URL=http://tradingbot-worker
NEXT_PUBLIC_API_URL=http://tradingbot-worker

# Backend target used by Next.js rewrites when running in same-origin proxy mode
API_PROXY_TARGET=http://tradingbot-worker
