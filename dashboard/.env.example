# Base URL of the TradingBot backend.
# When set, API requests go directly to this URL (backend must allow CORS).
# When empty, the dashboard calls the same-origin "/api/*" path and relies on
# the Next.js rewrites (see next.config.mjs / API_PROXY_TARGET) to reach the backend.
NEXT_PUBLIC_API_URL=

# Backend target used by the Next.js dev/prod server rewrites (same-origin mode).
# In Docker Compose, this points to http://tradingbot-worker:80 (or port 5000 / internal backend port).
API_PROXY_TARGET=http://tradingbot-worker:80

# Port on which Next.js server listens (default: 3000)
PORT=3000
