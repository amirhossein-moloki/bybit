# ==============================================================================
# TRADING BOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
Application__Environment=Production
Application__BotName=TelegramSignalTradingBot

# ------------------------------------------------------------------------------
# 2. Database Settings
# ------------------------------------------------------------------------------
# PostgreSQL root database password (used in Docker Compose orchestration)
DB_PASSWORD=YOUR_SECURE_PASSWORD

# Relational Database connection string
DATABASE_CONNECTION=Host=postgres;Database=tradingbot;Username=postgres;Password=YOUR_SECURE_PASSWORD
Database__ConnectionString=Host=postgres;Database=tradingbot;Username=postgres;Password=YOUR_SECURE_PASSWORD

# ------------------------------------------------------------------------------
# 3. Redis Caching Settings
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Telegram Client Settings
# ------------------------------------------------------------------------------
# Configuration section notation
Telegram__ApiId=1234567
Telegram__ApiHash=your_telegram_api_hash
Telegram__PhoneNumber=+1234567890
Telegram__SessionPath=/app/data/telegram/session
Telegram__Enabled=true

# Direct environment variable notation (overrides appsettings.json)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_PATH=/app/data/telegram/session

# Interactive CLI authentication variables (if required during initial login)
# TELEGRAM_VERIFICATION_CODE=
# TELEGRAM_PASSWORD=

# ------------------------------------------------------------------------------
# 5. Bybit & Exchange Settings
# ------------------------------------------------------------------------------
# Direct environment variables
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET
BYBIT_SECRET_KEY=YOUR_BYBIT_API_SECRET
BYBIT_ENVIRONMENT=Demo
BYBIT_DEMO_API_KEY=YOUR_BYBIT_DEMO_API_KEY
BYBIT_DEMO_API_SECRET=YOUR_BYBIT_DEMO_API_SECRET
BYBIT_MAINNET_API_KEY=YOUR_BYBIT_MAINNET_API_KEY
BYBIT_MAINNET_API_SECRET=YOUR_BYBIT_MAINNET_API_SECRET
BYBIT_PROXY_URL=socks5://host.docker.internal:10808

# Configuration section notation
Exchange__SelectedExchange=Bybit
Exchange__ApiKey=YOUR_BYBIT_API_KEY
Exchange__ApiSecret=YOUR_BYBIT_API_SECRET
Exchange__DemoApiKey=YOUR_BYBIT_DEMO_API_KEY
Exchange__DemoApiSecret=YOUR_BYBIT_DEMO_API_SECRET
Exchange__MainnetApiKey=YOUR_BYBIT_MAINNET_API_KEY
Exchange__MainnetApiSecret=YOUR_BYBIT_MAINNET_API_SECRET
Exchange__UseSandbox=true
Exchange__Environment=Demo
Exchange__RecvWindow=5000
Exchange__ProxyUrl=socks5://host.docker.internal:10808

# Dynamic Multi-Account Settings (Optional)
# Supports having multiple demo or mainnet accounts concurrently.
# Format: Exchange__Accounts__Index__Property
Exchange__Accounts__0__Name=MainDemoAccount
Exchange__Accounts__0__ApiKey=YOUR_DEMO_BYBIT_API_KEY
Exchange__Accounts__0__ApiSecret=YOUR_DEMO_BYBIT_API_SECRET
Exchange__Accounts__0__Environment=Demo
Exchange__Accounts__0__IsActive=true

Exchange__Accounts__1__Name=SecondaryRealAccount
Exchange__Accounts__1__ApiKey=YOUR_REAL_BYBIT_API_KEY
Exchange__Accounts__1__ApiSecret=YOUR_REAL_BYBIT_API_SECRET
Exchange__Accounts__1__Environment=Mainnet
Exchange__Accounts__1__IsActive=true

# ------------------------------------------------------------------------------
# 6. AI Provider & Signal Parser Settings
# ------------------------------------------------------------------------------
# AI Provider: Mock or OpenRouter
AI__Provider=Mock
AI__ApiKey=your_openrouter_api_key
AI__Endpoint=https://openrouter.ai/api/v1/chat/completions
AI__Model=openrouter/auto
AI__TimeoutSeconds=30
AI__MaxRetries=3

# Signal Parser & Validation Options
SignalDetection__MinimumScore=60
Parser__Version=1.0
Parser__MaxMessageLength=5000
Validation__RequireStopLoss=true
Validation__RequireTakeProfit=true
Validation__MaximumLeverage=100
Validation__RejectUnknownSymbols=true

# ------------------------------------------------------------------------------
# 7. Risk Management, Execution & Reliability Settings
# ------------------------------------------------------------------------------
RiskManagement__Enabled=true
RiskManagement__DefaultProfile=Balanced
RiskManagement__MaxRiskPerTrade=1.0
RiskManagement__MaximumLeverage=10.0

Execution__Enabled=true
Execution__MaxConcurrentExecutions=5
Execution__TimeoutSeconds=30

Reliability__Retry__Enabled=true
Reliability__Retry__MaxAttempts=3
Reliability__Retry__InitialDelaySeconds=1.0
Reliability__Retry__MaxDelaySeconds=10.0
Reliability__Retry__BackoffMultiplier=2.0
Reliability__Retry__JitterEnabled=true
Reliability__Timeout__Enabled=true
Reliability__Timeout__DefaultTimeoutSeconds=15.0

# ------------------------------------------------------------------------------
# 8. Monitoring Settings
# ------------------------------------------------------------------------------
Monitoring__HealthCheckIntervalSeconds=5
Monitoring__DatabaseTimeoutSeconds=3
Monitoring__BybitTimeoutSeconds=5

# ------------------------------------------------------------------------------
# 9. Notifications Settings
# ------------------------------------------------------------------------------
Notification__Enabled=true
Notification__Telegram__Enabled=true
Notification__Telegram__ChatId=-100987654321
TELEGRAM_CHAT_ID=-100987654321
Notification__Telegram__RetryCount=3
Notification__Telegram__InitialRetryDelaySeconds=2
Notification__Telegram__MaxRetryDelaySeconds=60
# Disable notifications globally if set to true:
# NOTIFICATIONS_DISABLED=false

# ------------------------------------------------------------------------------
# 10. Logging Settings
# ------------------------------------------------------------------------------
Logging__LogLevel=Information
Logging__EnableConsole=true
Logging__LogFilePath=logs/tradingbot.log

# ------------------------------------------------------------------------------
# 11. Security & Authentication Settings
# ------------------------------------------------------------------------------
# 32-character AES-256 key used for database encrypt/decrypt routines
ENCRYPTION_KEY=YOUR_32_CHARACTER_ENCRYPTION_KEY
Security__EncryptionKey=YOUR_32_CHARACTER_ENCRYPTION_KEY
Security__AllowedTelegramChatIds=12345678,98765432

# Dashboard Bearer Authentication Token
DASHBOARD_TOKEN=ValidDashboardReadToken
Security__DashboardToken=ValidDashboardReadToken

# ------------------------------------------------------------------------------
# 12. Dashboard & Reverse Proxy Settings
# ------------------------------------------------------------------------------
API_PROXY_TARGET=http://tradingbot-worker
NEXT_PUBLIC_API_URL=
