# ==============================================================================
# TRADING BOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# الگوی متغیرهای محیطی ربات معاملاتی (فایل نمونه تنظیمات)
# ==============================================================================
# Copy this file to '.env' and modify the values according to your configuration.
# این فایل را به نام '.env' کپی کرده و مقادیر را مطابق با نیاز خود تنظیم کنید.

# ------------------------------------------------------------------------------
# 1. Application & Environment Settings / تنظیمات عمومی برنامه
# ------------------------------------------------------------------------------
# ASPNETCORE_ENVIRONMENT: Execution environment (Production, Development, Staging)
# محیط اجرای برنامه (Production، Development یا Staging)
ASPNETCORE_ENVIRONMENT=Production
Application__Environment=Production
Application__BotName=TelegramSignalTradingBot

# Ports / پورت‌های ارتباطی سرویس‌ها
# External HTTP port for Nginx reverse proxy
# پورت عمومی سرویس Nginx جهت دسترسی به کل سیستم
HTTP_PORT=80

# External port for Web Dashboard
# پورت داشبورد مدیریتی وب
DASHBOARD_PORT=3000

# PostgreSQL Database external port (Optional for direct host connection)
# پورت بیرونی دیتابیس پستگرس برای اتصال مستقیم
POSTGRES_PORT=5432

# Redis Cache external port
# پورت بیرونی ردیس
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 2. Database Settings / تنظیمات دیتابیس PostgreSQL
# ------------------------------------------------------------------------------
# Database name, username and root password for PostgreSQL Docker container
# نام دیتابیس، نام کاربری و رمز عبور اصلی دیتابیس
POSTGRES_DB=tradingbot
POSTGRES_USER=postgres
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD

# Relational Database connection string used by .NET backend
# رشته اتصال دیتابیس که توسط بک‌اند دات‌نت استفاده می‌شود
DATABASE_CONNECTION=Host=postgres;Database=tradingbot;Username=postgres;Password=YOUR_SECURE_POSTGRES_PASSWORD
Database__ConnectionString=Host=postgres;Database=tradingbot;Username=postgres;Password=YOUR_SECURE_POSTGRES_PASSWORD

# ------------------------------------------------------------------------------
# 3. Redis Caching Settings / تنظیمات حافظه پنهان Redis
# ------------------------------------------------------------------------------
REDIS_HOST=redis

# ------------------------------------------------------------------------------
# 4. Security & Authentication / تنظیمات امنیت و توکن‌ها
# ------------------------------------------------------------------------------
# AES-256 32-character key for encrypting sensitive database fields (API keys, Telegram credentials)
# کلید ۳۲ کاراکتری AES-256 برای رمزنگاری داده‌های حساس دیتابیس (کلیدهای صرافی و توکن‌ها)
ENCRYPTION_KEY=YOUR_32_CHARACTER_ENCRYPTION_KEY
Security__EncryptionKey=YOUR_32_CHARACTER_ENCRYPTION_KEY

# Authentication Token for Web Dashboard API (Bearer token required for API access)
# توکن احراز هویت برای APIهای داشبورد وب
DASHBOARD_TOKEN=ValidDashboardReadToken
Security__DashboardToken=ValidDashboardReadToken

# Allowed Telegram Chat IDs for restricted bot administration (comma-separated)
# شناسه چت‌های مجاز تلگرام جهت دسترسی‌های مدیریتی (جداشده با کاما)
Security__AllowedTelegramChatIds=12345678,98765432

# ------------------------------------------------------------------------------
# 5. Telegram Client & Bot Settings / تنظیمات حساب کاربر و ربات تلگرام
# ------------------------------------------------------------------------------
# Telegram MTProto API Credentials (Obtained from https://my.telegram.org)
# اطلاعات API تلگرام برای اتصال MTProto (دریافت شده از my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE_NUMBER=+1234567890
TELEGRAM_PHONE=+1234567890
TELEGRAM_SESSION_PATH=/app/data/telegram/session

# Telegram Bot API Token (Used for sending alerts & notifications via ITelegramBotClient)
# توکن ربات تلگرام برای ارسال اعلان‌ها و هشدارها
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Proxy URL (Optional - SOCKS5 / HTTP Proxy for Telegram client)
# آدرس پروکسی برای تلگرام (اختیاری)
TELEGRAM_PROXY_URL=socks5://host.docker.internal:10808

# .NET Configuration Section Mapping (Overrides appsettings.json)
Telegram__ApiId=1234567
Telegram__ApiHash=your_telegram_api_hash
Telegram__PhoneNumber=+1234567890
Telegram__SessionPath=/app/data/telegram/session
Telegram__BotToken=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
Telegram__Enabled=true
Telegram__ProxyUrl=socks5://host.docker.internal:10808

# Interactive CLI Authentication variables (Optional if running OTP/2FA via CLI)
# TELEGRAM_VERIFICATION_CODE=
# TELEGRAM_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Bybit Exchange Settings / تنظیمات صرافی بای‌بیت
# ------------------------------------------------------------------------------
# Selected Exchange Environment: 'Demo' or 'Mainnet'
# محیط صرافی: 'Demo' (تست و دمو) یا 'Mainnet' (حساب واقعی)
BYBIT_ENVIRONMENT=Demo

# Active Bybit API Credentials
# کلیدهای عمومی و خصوصی API صرافی
BYBIT_API_KEY=YOUR_BYBIT_API_KEY
BYBIT_API_SECRET=YOUR_BYBIT_API_SECRET
BYBIT_SECRET_KEY=YOUR_BYBIT_API_SECRET

# Specific Demo and Mainnet API credentials (allows seamless environment switching)
# کلیدهای اختصاصی حساب دمو و حساب واقعی جهت سوئیچ سریع
BYBIT_DEMO_API_KEY=YOUR_BYBIT_DEMO_API_KEY
BYBIT_DEMO_API_SECRET=YOUR_BYBIT_DEMO_API_SECRET
BYBIT_MAINNET_API_KEY=YOUR_BYBIT_MAINNET_API_KEY
BYBIT_MAINNET_API_SECRET=YOUR_BYBIT_MAINNET_API_SECRET

# Bybit HTTP & WebSocket Proxy (Optional)
# پروکسی اختصاصی صرافی بای‌بیت
BYBIT_PROXY_URL=socks5://host.docker.internal:10808

# .NET Configuration Section Mapping
Exchange__SelectedExchange=Bybit
Exchange__ApiKey=YOUR_BYBIT_API_KEY
Exchange__ApiSecret=YOUR_BYBIT_API_SECRET
Exchange__DemoApiKey=YOUR_BYBIT_DEMO_API_KEY
Exchange__DemoApiSecret=YOUR_BYBIT_DEMO_API_SECRET
Exchange__MainnetApiKey=YOUR_BYBIT_MAINNET_API_KEY
Exchange__MainnetApiSecret=YOUR_BYBIT_MAINNET_API_SECRET
Exchange__UseSandbox=true
Exchange__Environment=Demo
Exchange__RecvWindow=5000
Exchange__ProxyUrl=socks5://host.docker.internal:10808

# ------------------------------------------------------------------------------
# 7. AI Provider & Signal Parser / تنظیمات هوش مصنوعی و استخراج سیگنال
# ------------------------------------------------------------------------------
# AI Provider: 'Mock' or 'OpenRouter'
# سرویس‌دهنده هوش مصنوعی: 'Mock' (تستی) یا 'OpenRouter' (مدل‌های واقعی)
AI__Provider=Mock
AI__ApiKey=your_openrouter_api_key
AI__Endpoint=https://openrouter.ai/api/v1/chat/completions
AI__Model=openrouter/auto
AI__TimeoutSeconds=30
AI__MaxRetries=3

# Signal Parser & Validation Rules
# حد نصاب امتیاز تشخیص سیگنال و قوانین اعتبار سنجی
SignalDetection__MinimumScore=60
Parser__Version=1.0
Parser__MaxMessageLength=5000
Validation__RequireStopLoss=true
Validation__RequireTakeProfit=true
Validation__MaximumLeverage=100
Validation__RejectUnknownSymbols=true

# ------------------------------------------------------------------------------
# 8. Risk Management & Execution Engine / مدیریت ریسک و موتور اجرای معاملات
# ------------------------------------------------------------------------------
RiskManagement__Enabled=true
RiskManagement__DefaultProfile=Balanced
RiskManagement__MaxRiskPerTrade=1.0
RiskManagement__MaximumLeverage=10.0

Execution__Enabled=true
Execution__MaxConcurrentExecutions=5
Execution__TimeoutSeconds=30

Reliability__Retry__Enabled=true
Reliability__Retry__MaxAttempts=3
Reliability__Retry__InitialDelaySeconds=1.0
Reliability__Retry__MaxDelaySeconds=10.0
Reliability__Retry__BackoffMultiplier=2.0
Reliability__Retry__JitterEnabled=true
Reliability__Timeout__Enabled=true
Reliability__Timeout__DefaultTimeoutSeconds=15.0

# ------------------------------------------------------------------------------
# 9. Monitoring & Observability / مانیتورینگ و پایش سلامت سیستم
# ------------------------------------------------------------------------------
Monitoring__HealthCheckIntervalSeconds=5
Monitoring__DatabaseTimeoutSeconds=3
Monitoring__BybitTimeoutSeconds=5

# ------------------------------------------------------------------------------
# 10. Notifications / تنظیمات سیستم ارسال اعلان‌ها
# ------------------------------------------------------------------------------
Notification__Enabled=true
Notification__Telegram__Enabled=true
Notification__Telegram__BotToken=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
Notification__Telegram__ChatId=-100987654321
TELEGRAM_CHAT_ID=-100987654321
Notification__Telegram__RetryCount=3
Notification__Telegram__InitialRetryDelaySeconds=2
Notification__Telegram__MaxRetryDelaySeconds=60
# Disable all system notifications globally if set to 'true':
# برای غیرفعال‌سازی کلی اعلان‌ها مقدار زیر را true بگذارید:
# NOTIFICATIONS_DISABLED=false

# ------------------------------------------------------------------------------
# 11. Logging Settings / تنظیمات ثبت لاگ‌ها
# ------------------------------------------------------------------------------
Logging__LogLevel=Information
Logging__EnableConsole=true
Logging__LogFilePath=logs/tradingbot.log

# ------------------------------------------------------------------------------
# 12. Dashboard & Reverse Proxy / تنظیمات داشبورد و پروکسی معکوس Next.js & Nginx
# ------------------------------------------------------------------------------
# Internal URL of backend worker service for Next.js rewrite proxy
# آدرس داخلی بک‌اند برای پروکسی داشبورد
API_PROXY_TARGET=http://tradingbot-worker

# External API URL (if frontend communicates directly with API bypassing rewrite proxy)
# آدرس مستقیم API در صورت اتصال مستقیم از مرورگر
NEXT_PUBLIC_API_URL=
